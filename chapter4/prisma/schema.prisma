generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//model - for js interpret the SQL tables
//syntax - model js_object
model User {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  password  String
  todos     Todo[]  //creates relation between two tables
}

model Todo {
  id        Int      @id @default(autoincrement())
  task      String
  completed Boolean @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}
