generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  createdAt DateTime @default(now()) 
  movies Movie[] @relation("MovieCreator")
  watchlist watchlistItem[]
}

model Movie{
  id String @id @default(uuid())
  title String
  overview String?
  releaseYear Int
  genres String[] @default([])
  runtime Int?
  posterUrl String?
  createdBy String
  createdAt DateTime @default(now())
  watchlist watchlistItem[]
  creater User @relation("MovieCreator",fields: [createdBy],references: [id],onDelete: Cascade)
}

model watchlistItem{
  id String @id @default(uuid())
  userId String
  movieId String
  status WatchlistStatus @default(PLANNED) //its a custom datatype i.e enum
  rating Int?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  //relations
  user User @relation(fields: [userId],references: [id], onDelete: Cascade) //deletes all linked items if the item is deleted
  movie Movie @relation(fields: [movieId],references: [id], onDelete: Cascade)
}

enum WatchlistStatus{
  PLANNED
  WATCHING
  COMPLETED
  DROPPED
}